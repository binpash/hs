#!/bin/bash
set -e

readonly SCRIPT_DIR="$( cd "$( dirname -- "${BASH_SOURCE[0]}" )" && pwd )"
readonly TOOLS_DIR="$SCRIPT_DIR/tools"
readonly MARKER_FILE="$TOOLS_DIR/.downloaded"

if [ -f "$MARKER_FILE" ]; then
    echo "Tools already downloaded (marker file exists: $MARKER_FILE)"
    exit 0
fi

echo "Downloading tools to $TOOLS_DIR..."
mkdir -p "$TOOLS_DIR"
cd "$TOOLS_DIR"

echo "Downloading Trimmomatic..."
if [ ! -f "trimmomatic.jar" ]; then
    curl -LO https://github.com/usadellab/Trimmomatic/releases/download/v0.40/Trimmomatic-0.40.zip
    unzip -q -o Trimmomatic-0.40.zip
    mv trimmomatic-0.40.jar trimmomatic.jar
    rm -rf Trimmomatic-0.40 Trimmomatic-0.40.zip
    echo "Trimmomatic downloaded successfully"
else
    echo "Trimmomatic already exists, skipping"
fi

echo "Downloading MACSE..."
if [ ! -f "macse_v1.01b.jar" ]; then
    curl -L -o macse_v1.01b.jar https://www.agap-ge2pop.org/wp-content/uploads/macse/releases/macse_v1.01b.jar
    echo "MACSE downloaded successfully"
else
    echo "MACSE already exists, skipping"
fi

echo "Downloading CaPTk from Kaggle..."
if [ ! -d "captk" ]; then
    kaggle datasets download -d mpsampat/captk-181-installerbin
    unzip -q captk-181-installerbin.zip
    rm captk-181-installerbin.zip

    chmod +x CaPTk_1.8.1_Installer.bin
    echo Y | ./CaPTk_1.8.1_Installer.bin

    ./CaPTk/1.8.1/captk --appimage-extract

    mv squashfs-root captk

    rm -rf CaPTk CaPTk_1.8.1_Installer.bin LICENSE

    echo "CaPTk downloaded and extracted successfully"
else
    echo "CaPTk already exists, skipping"
fi

touch "$MARKER_FILE"
echo "All tools downloaded successfully!"
