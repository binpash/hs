#!/usr/bin/env python3

import argparse
from pathlib import Path
import os
import shutil
import time
from subprocess import run, PIPE, DEVNULL

parser = argparse.ArgumentParser(description="Run benchmark")
parser.add_argument('--tmp-dir', type=str, help='tmp dir to map into docker')
parser.add_argument('--window', default=5, type=int, help='window size to run hs with')
parser.add_argument('--target', nargs='+', choices=['sh', 'hs', 'strace', 'fstrace'],
                    default=['sh', 'hs'], help='executors to run (sh, hs, strace, fstrace)')
parser.add_argument('--log', choices=['enable', 'disable'], default="enable",
                    help='whether to enable logging for hs')
parser.add_argument('--start', default=0000, type=int, help='start from a different script')
parser.add_argument('--end', default=9999, type=int, help='start from a different script')

env = os.environ.copy()
SCRIPT = "run_tests.sh"

docker_base_cmd = 'docker run --init --rm --privileged -v {}:/tmp hs/git-tests'

def do_sh_run(test_base: Path, output_base: Path, tmp_dir: str, env: dict):
    cmd = docker_base_cmd.format(tmp_dir).split()
    cmd.extend(['sh', SCRIPT])
    print(f"Running sh: {cmd}")
    before = time.time()
    result = run(cmd, stdout=PIPE, env=env)
    duration = time.time() - before
    with open(output_base / 'sh_time', 'w') as f:
        f.write(f'{duration}\n')
    return result.returncode, result.stdout

def do_hs_run(test_base: Path, output_base: Path, hs_base: Path, window: int, tmp_dir: str, env: dict, log: bool):
    cmd = docker_base_cmd.format(tmp_dir).split()
    cmd.extend(['/srv/hs/pash-spec.sh', '--window', str(window)])
    if log:
        cmd.extend(['-d', '2'])
    cmd.append(SCRIPT)
    print(f"Running hs: {cmd}")
    before = time.time()
    result = run(cmd, stdout=PIPE, stderr=DEVNULL, env=env)
    duration = time.time() - before
    with open(output_base / 'hs_time', 'w') as f:
        f.write(f'{duration}\n')
    return result.returncode, result.stdout

def do_strace_run(test_base: Path, output_base: Path, tmp_dir: str, env: dict):
    output_dir = output_base / 'strace'
    output_dir.mkdir(parents=True, exist_ok=True)

    logfile = '/tmp/strace_log'
    cmd = docker_base_cmd.format(tmp_dir).split()
    cmd.extend(['strace', '-y', '-f', '--seccomp-bpf', '--trace=fork,clone,%file',
                '-o', logfile, 'sh', SCRIPT])

    print(f"Running strace: {cmd}")
    before = time.time()
    result = run(cmd, stdout=PIPE, stderr=PIPE, env=env)
    duration = time.time() - before

    with open(output_dir / 'stdout', 'wb') as f:
        f.write(result.stdout)
    with open(output_dir / 'stderr', 'wb') as f:
        f.write(result.stderr)
    with open(output_base / 'strace_time', 'w') as f:
        f.write(f'{duration}\n')

    src = Path(tmp_dir) / 'strace_log'
    if src.exists():
        shutil.copy(src, output_dir / 'strace_log')

    return result.returncode

def do_fstrace_run(test_base: Path, output_base: Path, tmp_dir: str, env: dict):
    output_dir = output_base / 'fstrace'
    output_dir.mkdir(parents=True, exist_ok=True)

    trace_file = '/tmp/tv3_trace'
    dep_file = '/tmp/tv3_deps'
    missed_file = '/tmp/tv3_missed'

    cmd_inner = (
        f'fstrace install && '
        f'fstrace --trace-file {trace_file} --dep-file {dep_file} --missed-file {missed_file} '
        f'-- sh {SCRIPT}'
    )

    cmd = ['sudo', 'bash', '-c',
           f'ulimit -l unlimited && docker run --init --rm --privileged --pid=host --net=host --cgroupns=host '
           f'-v {tmp_dir}:/tmp '
           f'-v /lib/modules:/lib/modules:ro '
           f'-v /usr/src:/usr/src:ro '
           f'-v /sys/kernel/tracing:/sys/kernel/tracing:rw '
           f'-v /sys/fs/bpf:/sys/fs/bpf '
           f'hs/git-tests sh -c \'{cmd_inner}\'']

    print(f"Running fstrace: {cmd}")
    before = time.time()
    result = run(cmd, stdout=PIPE, stderr=PIPE, env=env)
    duration = time.time() - before

    with open(output_dir / 'stdout', 'wb') as f:
        f.write(result.stdout)
    with open(output_dir / 'stderr', 'wb') as f:
        f.write(result.stderr)
    with open(output_base / 'fstrace_time', 'w') as f:
        f.write(f'{duration}\n')

    for src_name, dst_name in [('tv3_trace', 'trace'), ('tv3_deps', 'deps'), ('tv3_missed', 'missed')]:
        src = Path(tmp_dir) / src_name
        if src.exists():
            shutil.copy(src, output_dir / dst_name)

    return result.returncode

if __name__ == '__main__':
    args = parser.parse_args()
    test_base = Path(__file__).parent.resolve()
    hs_base = test_base.parent.parent.parent

    local_name = os.sep.join(test_base.parts[-1:])
    output_base = hs_base / "report" / "output" / local_name
    tmp_dir = args.tmp_dir

    run_sh = 'sh' in args.target
    run_hs = 'hs' in args.target
    run_strace = 'strace' in args.target
    run_fstrace = 'fstrace' in args.target

    if not any([run_sh, run_hs, run_strace, run_fstrace]):
        raise ValueError("Not running anything, add --target argument")

    if not tmp_dir:
        raise ValueError("Not running, need --tmp-dir")

    output_base.mkdir(parents=True, exist_ok=True)

    if run_sh:
        output_sh = do_sh_run(test_base, output_base, tmp_dir, env)
    if run_hs:
        output_hs = do_hs_run(test_base, output_base, hs_base, args.window, tmp_dir, env, args.log == 'enable')
    if run_strace:
        do_strace_run(test_base, output_base, tmp_dir, env)
    if run_fstrace:
        do_fstrace_run(test_base, output_base, tmp_dir, env)
    if run_sh and run_hs:
        with open(output_base / 'error', 'w') as errf:
            if output_sh == output_hs:
                errf.write('')
            else:
                errf.write('error\n')
                errf.write(f'return code {output_sh[0]} vs {output_hs[0]}\n')
                errf.write('==== output sh ====\n')
                errf.write(output_sh[1].decode('UTF-8'))
                errf.write('==== output hs ====\n')
                errf.write(output_hs[1].decode('UTF-8'))
