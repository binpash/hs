#!/bin/sh
# deleteuser removes the users listed in usernames_sh. Each target starts with
# them freshly created; afterwards whether anything of them is left is
# recorded in OUTPUT_DIR.
users=$(cat "$(dirname "$0")/usernames_sh")
case $1 in
before)
    for u in $users; do
        userdel -r "$u" 2>/dev/null
        groupdel "$u" 2>/dev/null
        # A fixed uid no host account has: with the host's pid and cgroup
        # namespaces visible, uid 1000 would match the host user's processes
        # and cgroups, which the script's `find / -uid` then lists.
        useradd -m -u 4242 -s /bin/bash "$u" || exit 1
        echo "$u:${u}123456789" | chpasswd || exit 1
    done ;;
after)
    for u in $users; do
        echo "$u passwd: $(grep -c "^$u:" /etc/passwd) shadow: $(grep -c "^$u:" /etc/shadow)"
        [ -e "/home/$u" ] && echo "/home/$u still exists"
    done > state ;;
esac
