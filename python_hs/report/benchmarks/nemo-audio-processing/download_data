#!/bin/bash

set -eu

REPO=MLCommons/speech-wikimedia
OUT=data/nemo-audio-processing/
N=256

# to top directory of this script
cd -- "$(dirname -- "${BASH_SOURCE[0]}")" || exit
# to the report directory
cd ../../ || exit


mkdir -p "$OUT"

curl -s "https://huggingface.co/api/datasets/$REPO/tree/main?recursive=1" |
  jq -r '.[] | select(.type=="file" and (.path|endswith(".flac"))) | "\(.size)\t\(.path)"' |
  sort -nr |
  head -n "$N" |
  cut -f2 |
  xargs -I {} \
        hf download --repo-type dataset --local-dir "$OUT" "$REPO" {}
