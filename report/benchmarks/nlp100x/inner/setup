#!/bin/bash

SPEC_TOP="$(git rev-parse --show-toplevel)"
RESOURCE_DIR="${SPEC_TOP}/report/resources/nlp100x/"
INFLATE_SCRIPT="python3 ${SPEC_TOP}/report/util/inflate_x.py" # Inflate x times
INFLATE_SIZE="100"

mkdir -p $RESOURCE_DIR
cd $RESOURCE_DIR

if [ ! -f ./book_links.txt ]; then
    wget -q --show-progress --progress=bar:force:noscroll -O book_links.txt "https://atlas-group.cs.brown.edu/data/gutenberg/books.txt"
    if [ ! -f book_links.txt ]; then
        echo "Failed to download book_links.txt"
        exit 1
    fi
fi

if [ ! -f ./genesis ]; then
    wget -q --show-progress --progress=bar:force:noscroll -O genesis "https://atlas-group.cs.brown.edu/data/gutenberg/8/0/0/8001/8001.txt"
fi 

if [ ! -f ./exodus ]; then
    wget -q --show-progress --progress=bar:force:noscroll -O exodus "https://atlas-group.cs.brown.edu/data/gutenberg/3/3/4/2/33420/33420-0.txt"
fi

if [ ! -e ./pg ]; then
    book_count=120
    # 120 small files: fetch them concurrently instead of one wget at a time.
    head -n $book_count book_links.txt \
        | sed 's|^|https://atlas-group.cs.brown.edu/data/gutenberg/|' \
        | "$SPEC_TOP/report/util/fetch_parallel.sh" pg
fi

# Inflate the files
cd $RESOURCE_DIR
for file in *; do
    if [ -f $file ] && [ "$file" != "book_links.txt" ]; then
        echo "Inflating $file"
        $INFLATE_SCRIPT $file $INFLATE_SIZE -i
    fi
done

cd $RESOURCE_DIR/pg
for file in *; do
    if [ -f $file ]; then
        echo "Inflating $file"
        $INFLATE_SCRIPT $file $INFLATE_SIZE -i
    fi
done
