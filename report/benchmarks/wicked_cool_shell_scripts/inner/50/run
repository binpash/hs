#!/bin/bash

# Base directories
BENCHMARK_NO="50"
HS_BASE="$(git rev-parse --show-toplevel)"
TEST_BASE="$HS_BASE/report/benchmarks/wicked_cool_shell_scripts/$BENCHMARK_NO"
TEST_UPPER="$HS_BASE/report"
RESOURCE_DIR="$HS_BASE/report/benchmarks/wicked_cool_shell_scripts/$BENCHMARK_NO"

# Script to run
SCRIPT_NAME="$BENCHMARK_NO.sh"

# rotatelogs works on $TEST_BASE/log: point it at the per-target copy.
ARGS=()

ENV_VARS=(
    'TEST_BASE=$OUTPUT_DIR'
)

# Pass arguments to the global script. `hook` puts the system in the same
# state before each target and records what the script changed afterwards.
python3 "$TEST_UPPER/run_benchmark.py" \
    --script_name "$SCRIPT_NAME" \
    --test_base "$TEST_BASE" \
    --hs_base "$HS_BASE" \
    --env_vars "${ENV_VARS[@]}" \
    --hook "$TEST_BASE/hook" \
    "$@" \
    --script-args "${ARGS[@]}"
