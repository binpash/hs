#!/bin/bash

export PATH=$PATH:$HOME/.local/bin
export PASH_SPEC_TOP=${PASH_SPEC_TOP:-$(git rev-parse --show-toplevel --show-superproject-working-tree)}
export BIODIR="${PASH_SPEC_TOP}/report/benchmarks/bio4"

download_dir="${PASH_SPEC_TOP}/report/resources/bio4/"
mkdir -p "$download_dir"
# Which list of BAMs to download, relative to $BIODIR. Defaults to every
# sample; pass -i small/list (or medium/, large/) to fetch only one size's
# worth, which is what the Dockerfile's BIO4_INPUT_LIST build arg feeds in.
INPUT_LIST="input_full.txt"


download_bam_files() {
    local input_file=$1
    while IFS='-' read -r pop sample link; do
        # aria2c keeps a $sample.bam.aria2 control file until the download
        # is complete, so a file that was interrupted (Ctrl-C, a stall that
        # outlasted the retries) is not "already there": -c resumes it.
        if [[ ! -f "$download_dir/$sample.bam" || -f "$download_dir/$sample.bam.aria2" ]]; then
            echo "Downloading $sample..."
            # EBI caps each connection at ~0.4 MB/s but serves byte ranges, so
            # split every file across 16 connections: measured 7.3 MB/s against
            # 0.4 for a single wget. -c resumes a partial file; the retry flags
            # ride out the mid-transfer stalls that used to hang a build.
            # Not -q: a failed download must say why, and stop the setup.
            if ! aria2c --console-log-level=warn --summary-interval=0 --download-result=hide \
                -x16 -s16 -k1M -c --max-tries=5 --retry-wait=5 \
                --file-allocation=none -d "$download_dir" -o "$sample.bam" "$link"; then
                echo "Error: downloading $sample from $link failed" >&2
                exit 1
            fi
        else
            echo "File $sample.bam already exists, skipping download."
        fi
    done < "$input_file"
}

while getopts ":i:c" opt; do
    case $opt in
        i)
            INPUT_LIST="$OPTARG"
            ;;
        c) 
            echo "Cleaning up..."
            rm -rf "$download_dir"/../output
            exit 0
            ;;
        C)
            echo "Cleaning up and removing input files..."
            rm -rf "$download_dir"/*.bam
            rm -rf "$download_dir"/*.sam
            rm -rf "$download_dir"/../output
            rm -f "$input_file"
            exit 0
            ;;
        \?) echo "Invalid option -$OPTARG" >&2
            exit 1
            ;;
    esac
done

input_file="${BIODIR}/$INPUT_LIST"
download_bam_files "$input_file"
