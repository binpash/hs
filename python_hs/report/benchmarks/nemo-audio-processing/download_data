#!/usr/bin/env python3

import os, shutil
from pathlib import Path
from datasets import load_dataset, Audio

DATASET = "MLCommons/speech-wikimedia"
SPLIT = "train"
N_FILES = 20  # top N largest
OUT_DIR = Path(__file__).resolve().parents[1] / "data" / "nemo-audio-processing"


def main() -> None:
    OUT_DIR.mkdir(parents=True, exist_ok=True)

    ds = load_dataset(DATASET, split=SPLIT, streaming=True).cast_column(
        "audio", Audio(decode=False)
    )

    sizes = {}
    for ex in ds:
        p = Path(ex["audio"]["path"])
        if p.exists() and p not in sizes:
            sizes[p] = os.path.getsize(p)

    for p in sorted(sizes, key=sizes.get, reverse=True)[:N_FILES]:
        dest = OUT_DIR / p.name
        i = 1
        while dest.exists():
            dest = OUT_DIR / f"{p.stem}_{i}{p.suffix}"
            i += 1
        shutil.copy2(p, dest)
        print(f"{dest.name}: {sizes[p] / (1024 * 1024):.1f} MB")


if __name__ == "__main__":
    main()
