#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PASH_SPEC_TOP=${PASH_SPEC_TOP:-$(git -C "$script_dir" rev-parse --show-toplevel --show-superproject-working-tree | awk 'NF { print; exit }')}

# shellcheck source=report/docker_common.sh
source "$PASH_SPEC_TOP/report/docker_common.sh"

# Building riker on top of the base hs image.
hs_require_base_image "$PASH_SPEC_TOP"
hs_docker build -t hs-riker "$PASH_SPEC_TOP"/report/benchmarks/riker/

for experiment in autoconf calc coreutils llvm lsof lua make memcached protobuf redis sqlite vim xz xz-clang; do
    echo "Building hs/$experiment docker image..."
    hs_docker build -t hs/$experiment "$PASH_SPEC_TOP"/report/benchmarks/riker/$experiment/
done
